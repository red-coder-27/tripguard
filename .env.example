# TripGuard Environment Configuration
# Copy this file to .env and adjust variables as needed

# Server Configuration
PORT=5000
NODE_ENV=development

# Security
JWT_SECRET=replace-with-a-secure-random-jwt-secret-key-at-least-32-chars
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173

# Database
# If left blank or connection fails, the server gracefully uses an embedded in-memory MongoDB instance
MONGODB_URI=mongodb://localhost:27017/tripguard

# AI Copilot (Google Gemini API)
# Optional: If not provided, TripGuard automatically uses deterministic financial explanation fallback
GEMINI_API_KEY=

# Seed Data Configuration
SEED_DEMO_USER_EMAIL=demo@tripguard.ai
SEED_DEMO_USER_PASSWORD=TripGuard2026!
