# ==========================================
# TRIPGUARD - PRODUCTION & DEPLOYMENT ENVIRONMENT
# ==========================================

# ------------------------------------------
# 1. SERVERLESS / BACKEND ENVIRONMENT (Vercel Project Settings)
# ------------------------------------------
NODE_ENV=production
PORT=5000

# Security (Required in Production: min 16 characters, must not be dev fallback)
JWT_SECRET=REPLACE_WITH_A_SECURE_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
JWT_EXPIRES_IN=7d

# CORS Allowed Origin(s) (e.g. https://tripguard.vercel.app or comma-separated list)
CORS_ORIGIN=https://your-tripguard-app.vercel.app
ALLOW_VERCEL_PREVIEWS=true
# Express Trust Proxy: 1 for single reverse proxy hop behind Vercel/Nginx
TRUST_PROXY=1

# Database - MongoDB Atlas (Required in Production: must start with mongodb+srv:// or mongodb://)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/tripguard?retryWrites=true&w=majority

# External Intelligence Providers (Optional / Graceful deterministic fallbacks available)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash
GEOAPIFY_API_KEY=YOUR_GEOAPIFY_API_KEY
OPENWEATHER_API_KEY=YOUR_OPENWEATHER_API_KEY
MAPTILER_API_KEY=YOUR_MAPTILER_API_KEY

# Demo User Provisioning (Development only - never auto-seeded in production)
SEED_DEMO_USER_EMAIL=demo@tripguard.ai
SEED_DEMO_USER_PASSWORD=TripGuard2026!

# ------------------------------------------
# 2. CLIENT / FRONTEND ENVIRONMENT (Prefix VITE_ for Vite bundler)
# ------------------------------------------
VITE_MAPTILER_API_KEY=YOUR_MAPTILER_API_KEY
